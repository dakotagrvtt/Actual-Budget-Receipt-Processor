# ./receipts setup copies this file to .env and asks for the required values (or copy it and fill it in yourself).
# Lines starting with # are comments. A setting shown with a leading # (like #LEARNING=on) is optional: remove the # to change it.
# Every default shown here is what the pipeline uses when the line is missing.
# Keep .env private (chmod 600 .env): it holds passwords.
# Wrap any value containing spaces, # or quotes in single quotes, e.g. ACTUAL_PASSWORD='p#ss word'
# After editing .env, run ./receipts restart.
# Many of these (connections, matching, categorizing, check interval, holidays, keywords, learning) can also be changed on the
# status page's Settings tab. A value saved there wins over this file and applies at the next check, without a restart.
# Nothing here sends data anywhere except to your own Actual and Nextcloud servers, unless you switch on the optional
# cloud reader or hosted decider near the end of this file (both are off by default).
#
# Sections: Actual Budget · Matching · Nextcloud · Categorizing · Behaviour · Holidays and gift meals · Keywords ·
# Learning · Reader model · GPU · Decider · Cloud reader · Hosted decider · Advanced

# ---- Actual Budget ----
# Same URL you open in the browser. For Actual running on this same computer: http://host.docker.internal:5006
ACTUAL_SERVER_URL=https://actual.example.com
# The server password you log in with.
ACTUAL_PASSWORD=
# Actual: Settings → Show advanced settings → Sync ID
ACTUAL_SYNC_ID=
# Only if the budget uses end-to-end encryption.
ACTUAL_E2E_PASSWORD=
# Which version of Actual's programming interface (@actual-app/api) the worker uses. It must match your Actual server.
# auto = the worker uses the version your Actual server runs (installed once into data/actual-api; needs internet once per
# Actual upgrade, falls back to the version in the image if offline). After an Actual upgrade the worker notices within
# about 10 minutes and restarts itself. Or pin a version (e.g. 26.11.0) or use latest, and run ./receipts update after
# changing it. If this line is missing, the default is auto.
# Splitting existing transactions needs 26.8.0 or newer.
ACTUAL_API_VERSION=auto

# ---- Matching a receipt to its bank charge ----
# Accounts searched for the bank transaction a receipt belongs to (comma-separated names).
# Empty = all open, on-budget accounts.
MATCH_ACCOUNTS=
# How many days after the receipt date the bank transaction may post (it may also be dated 1 day before).
MATCH_DAYS=4
# Receipts with no readable purchase date: a charge in the MATCH_NO_DATE_RECENT_DAYS before the upload is used
# (and anything that moves money goes to review); one found only further back, up to MATCH_NO_DATE_LOOKBACK_DAYS,
# is listed for review and never applied. Uploading a batch of old receipts? Raise MATCH_NO_DATE_RECENT_DAYS for it.
MATCH_NO_DATE_RECENT_DAYS=14
MATCH_NO_DATE_LOOKBACK_DAYS=365
# A receipt often arrives before its bank charge. With no match yet, it stays in the inbox until the charge could
# have posted (through the day after the MATCH_DAYS window ends; undated: MATCH_DAYS + 1 days after the upload),
# and is re-checked this often (minutes). "Check for receipts now" on the status page (or ./receipts run-now) re-checks right away.
MATCH_RECHECK_MINUTES=60
# A matching charge the bank hasn't cleared yet is waited on this many days longer; after that it's applied and reviewed.
MATCH_PENDING_WAIT_DAYS=2
# Allow the charge to exceed the receipt total by this % (e.g. 25 for restaurant tips).
MATCH_TOLERANCE_PERCENT=0
# 0–1: how closely the bank payee must match the receipt's merchant name.
# Different spellings of one store can be listed in data/payee-aliases.json (see payee-aliases.example.json).
PAYEE_MIN_SCORE=0.6
# Charges your Actual rules already categorized are still matched: a receipt spanning several categories splits them,
# one that agrees just gets a #receipt note. If the receipt points to a single *different* category:
# true = switch it to the receipt's category (only if an item is clearly sure about it), false = send it to review
# (your rule wins). Existing splits are never touched.
OVERWRITE_CATEGORIZED=true
# Split a transaction by category when a receipt spans several; false = largest category only.
SPLIT_TRANSACTIONS=true
# Parts smaller than this (e.g. one $0.79 item) are folded into the transaction's current or largest category.
SPLIT_MIN_AMOUNT=1.00

# ---- Nextcloud ----
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=
# Nextcloud: Personal settings → Security → Create new app password
NEXTCLOUD_APP_PASSWORD=
RECEIPTS_INBOX=/Receipts/Inbox
RECEIPTS_PROCESSED=/Receipts/Processed
RECEIPTS_REVIEW=/Receipts/Needs review

# ---- Categorizing ----
# The decider (the decider-gguf service; the model is DECIDER_MODEL, chosen by setup) picks a category for each item,
# using how you filed past purchases at the same store. See "Decider" below to change the model.
# Categories receipts never go to (bills, debt and savings are routed by Actual rules).
# Whole groups, and/or single "Group / Category" labels, comma-separated. ./receipts exclude lists your categories and sets
# both (setup offers it too). Excluded categories are also hidden on the status page's Categories tab.
# e.g. EXCLUDE_CATEGORY_GROUPS='Bills,Debt,Savings' and EXCLUDE_CATEGORIES='Usual Expenses / Rent'
# A group name may contain " / " ("Bills / Utilities"): give it in full.
EXCLUDE_CATEGORY_GROUPS='Bills'
EXCLUDE_CATEGORIES=
# Your descriptions of each category live in data/category-notes.json (see category-notes.example.json); edit them on
# the status page (Categories). Changes apply at the next receipt, no restart needed.
# Drop store department codes like "MED-" / "BED-" from item names before categorizing ("MED" reads as medical).
STRIP_DEPARTMENT_PREFIXES=true
# Also have the reader write each item in plain words. Off: in testing it decoded "MED-CHILD PIC" (children's books) as "child milk".
READ_PLAIN_NAMES=false
# Confidence is the top category's probability. Items below this (0–1) are unsure (see UNSURE_ITEMS_USE_STORE_CATEGORY below).
CATEGORY_MIN_CONFIDENCE=0.5
# Items under that confidence stay in the store's usual category (from your Actual rules, or the transaction's
# current category) instead of becoming an Uncategorized part; only confident items are split out.
UNSURE_ITEMS_USE_STORE_CATEGORY=true
# Confidence needed to move an item OUT of the store's usual category (split it off). The default is 0.6, or
# CATEGORY_MIN_CONFIDENCE if that is higher. In testing 0.6 stopped marginal wrong moves, and lower bars split out more
# wrong items (docs/research.md sections 7 and 9).
# Like MOVE_MIN_MARGIN below, it only applies when there is a store category to fall back to (UNSURE_ITEMS_USE_STORE_CATEGORY).
MOVE_MIN_CONFIDENCE=0.6
# Also needed to move an item out: its category must be ahead of the best other one by at least this much (0–1).
# Stops near ties (50/50) from moving money. An answer without probabilities has no margin and passes.
MOVE_MIN_MARGIN=0.2
# One extra decider question per receipt (two or more items): which single category fits the whole purchase? When that
# answer is confident, an item only leaves it if its own pick clearly wins (the MOVE_MIN_* gate, and a lead of MOVE_MIN_MARGIN
# over the receipt's category); the other items take the receipt's category. Lets a food-court visit stay one category
# instead of splitting. Costs one more decider request per receipt (one more anonymized request with the hosted decider).
# false = per-item answers only: use it to compare with replay.
RECEIPT_CHECK=true
# How sure (0-1) the whole-purchase answer must be to override items. Same bar as CATEGORY_MIN_CONFIDENCE.
# Replay saves the numbers (replay-items.json: receiptTopProbability), so you can try other values offline.
RECEIPT_CHECK_MIN_CONFIDENCE=0.5
# Spread the receipt's tax over the taxed items only, when the reader saw which items the receipt marks as taxed (a tax
# code such as T or A, or a tax column), so untaxed groceries don't pay tax on taxed household goods. Used only when the
# marks are complete, the receipt adds up (subtotal, tax, tip, total), and the tax is a believable rate (above 0, up to
# TAX_BY_ITEM_MAX_RATE) of the taxed items. With several tax codes (two rates), each printed tax line is spread over the
# items with its code. If the lines are missing, don't add up or don't match the items, tax is spread in proportion to the
# amounts instead. When the items add up to MORE than the printed subtotal (a coupon the reader missed), the same tax
# lines are used to find which items to correct, and the receipt goes to review. Turning this on also adds a few short
# rules to the reader's instructions and has it copy the tax lines and each item's tax code.
# false = always proportional: use it to compare with replay.
TAX_BY_ITEM=true
# The highest tax rate (tax / taxed items) believed; above it the tax is spread in proportion.
TAX_BY_ITEM_MAX_RATE=0.12
# true = when some items are unsure or missing, still apply the confident part (unsure money left Uncategorized,
# parent note tagged #review) and send the receipt to Needs review; false = change nothing and send it to review.
APPLY_THEN_REVIEW=true
# How far back, and how many, past purchases at the same store to learn from
# (counted back from the day before the purchase date, for the live worker, replay and item-test alike).
HISTORY_DAYS=365
HISTORY_LIMIT=10
# Also show the decider how similar items from any store were filed before (up to 8 past items that share words with
# the item). On by default, because it tested slightly better.
SIMILAR_ITEMS=true
# How many of your newest split notes per category the decider sees with every item ("Egg Book @thrift shop" under
# Child). They help with items it has never seen; fewer is faster. In testing 15, 5 and 0 scored within a point of each
# other, but 0 sent one DVD to review that 15 and 5 got right; 5 was about 25% faster than 15 (docs/research.md
# section 8). 0 sends none.
HOUSEHOLD_EXAMPLES=5

# ---- Behaviour ----
# true = log what would change, touch nothing in Actual or Nextcloud.
# Only used until you first switch on the status page (or ./receipts mode). From then on data/settings.json is the
# switch and DRY_RUN here is ignored (a warning says so); delete that file to use this value again.
DRY_RUN=true
# How often the inbox is checked, in seconds. The status page button (or ./receipts run-now) checks right away.
POLL_SECONDS=300
# Status page and webhook (./receipts trigger-url shows the link). ./receipts setup / start generate the token if it's
# empty. The page is plain HTTP and the link contains the token: keep it on your own network and keep the link private.
# Anyone with the token can check the inbox, see recent results and receipt photos, go live, retry receipts and edit
# descriptions, keywords and the privacy lists.
TRIGGER_TOKEN=
# 127.0.0.1 = this machine only; 0.0.0.0 = any device on your network (phone, Nextcloud webhook).
TRIGGER_BIND=127.0.0.1
# Time zone for times shown on the status page (./receipts setup fills in this computer's).
TRIGGER_TIMEZONE=UTC
# Receipts are downscaled to this many pixels on the long side before the reader sees them.
MAX_IMAGE_SIDE=2240

# ---- Holidays and gift meals ----
# Holidays near the purchase date (Valentine's, Easter, Mother's/Father's Day, Halloween, Thanksgiving, Christmas)
# are shown to the decider as a gift hint. Computed locally; nothing is read. These are US holidays.
OCCASIONS=true
OCCASION_DAYS_BEFORE=14
OCCASION_DAYS_AFTER=2
# Also read birthday/anniversary/holiday events from your Nextcloud calendars. Off by default.
OCCASIONS_CALENDAR=false
# Which calendars to read, by name (comma-separated). Empty = all of them, using only events that look like a
# birthday, anniversary or holiday. With names listed, every all-day event in those calendars counts.
# (With the hosted decider, event names are never sent: any such occasion goes out as "a birthday or personal occasion".)
#OCCASIONS_CALENDARS='Birthdays,Family'
# A restaurant charge over this many dollars goes to review (may be a gift meal or need splitting). 0 = off.
GIFT_MEAL_MIN=50
# The "Group / Category" label that counts as restaurants for GIFT_MEAL_MIN (default 'Daily Expenses / Restaurants').
#RESTAURANT_CATEGORY='Daily Expenses / Restaurants'

# ---- Household keywords (status page, ./receipts keyword ..., or #always / #usually in an Actual note) ----
# off | mixed | final | hint
#   mixed (recommended): "always" keywords skip the model, "usually" ones are hints
#   final: every match skips the model. hint: every match is a hint; probabilities are reweighted. off: keywords are ignored.
KEYWORD_MODE=mixed
# "usually" keywords: multiply the keyword category's probability by this (1 = tell the model only; 4 and 20 scored the same in testing).
KEYWORD_HINT_WEIGHT=20
# Where keywords are stored (inside the container; ./data is /data).
#KEYWORDS_PATH=/data/keywords.json

# ---- Learning from your corrections (Learned page on the status page) ----
# When you change a category the pipeline set in Actual, it notices (every few hours, never blocking a receipt) and learns.
# on = learn and use it | record = learn but don't use it yet (to compare) | off = no learning at all
#LEARNING=on
# Where it keeps what it learned (inside the container; ./data is /data).
#MEMORY_DIR=/data/memory

# ---- Reader model (the llm service that reads receipts) ----
# The local reader model, as <Hugging Face repo>:<quant>, like DECIDER_MODEL. Default: unsloth/Qwen3.5-4B-GGUF:Q8_0 (about
# 5.6 GB of graphics memory), with its BF16 image projector. It must be a vision model (a repo with an mmproj file);
# download-models says so if it is not. After changing it: ./receipts download-models, then ./receipts restart. A bigger
# model needs more graphics memory, and accuracy is not guaranteed: measure it with ./receipts replay on your own receipts
# before you rely on it. Remove the line to go back to the default.
#READER_LOCAL_MODEL=bartowski/MiMo-V2.6-Distill-Qwen-9B-GGUF:Q4_K_M
# Optional: which image projector of the repo to use, a file name or a quant such as F16 (default: BF16 for the default
# model, the best one the repo has for another: BF16, then F16, then F32).
#READER_LOCAL_MMPROJ=
# The settings below apply only to the local reader, not to the cloud reader.
# Name shown in the logs for the local reader (default: taken from READER_LOCAL_MODEL, else Qwen3.5-4B).
#LLM_NAME=Qwen3.5-4B
# Sampling settings as JSON, for trying another local reader (default shown).
#LLM_SAMPLING='{"temperature":0.1,"top_k":20,"top_p":0.95,"min_p":0,"repeat_penalty":1}'
# true = let the reader think before answering. Default false: thinking gave the same results in testing, 2.4x slower.
# It also needs READER_REASONING_BUDGET to be above 0 (tokens, e.g. 1024; default 0 = thinking off in llama.cpp).
#LLM_THINKING=false
#READER_REASONING_BUDGET=0

# ---- GPU ----
# AMD and Intel run the default Vulkan images. The containers need your host's 'render' group:
# getent group render   →   render:x:<GID>:
RENDER_GID=987
# NVIDIA (CUDA images), a smaller memory budget and/or no GPU: the extra compose files, ':'-separated.
# ./receipts setup picks them for your hardware. See docs/research.md, "Hardware".
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
#COMPOSE_FILE=compose.yaml:compose.small-gpu.yaml
#COMPOSE_FILE=compose.yaml:compose.cpu.yaml
# GPU layers per model: 99 = all on the GPU (default), 0 = run on the processor (slower; ./receipts setup sets both to 0
# when it finds no GPU). 0 for the decider alone saves about 2.3–2.7 GB of graphics memory.
#LLM_GPU_LAYERS=99
#DECIDER_GPU_LAYERS=99
# Seconds without requests before a model unloads itself and frees its graphics memory (it reloads in a few seconds
# on the next receipt; a decider request wakes it too). -1 keeps both models loaded all the time. On a shared GPU use -1:
# while a model sleeps another app can take its memory, and the reload then fails.
#MODEL_SLEEP_SECONDS=300

# ---- Decider (the model that picks the categories) ----
# Any /v1/systemone GGUF model; after changing it, run ./receipts download-models (fetches it into ./models), then
# ./receipts restart. Setup asks, suggesting d3-flash 9B when the GPU has 14 GB or more. LiquidAI/d1-2B-GGUF:Q8_0
# (2.7 GB) is the default without setup. vLLM d3-flash 9B splits out more of the right items (95.8% vs 90.9% on the
# test receipts) but needs about 6.8 GB; give it a smaller context and batch (its prompts are under 2.5k tokens).
# Ignored with the hosted decider.
#DECIDER_MODEL=ggml-org/vllm-d3-flash-GGUF:Q4_K_M
#DECIDER_CTX=8192
#DECIDER_BATCH=4096
# (defaults: 16384 and 8192; 8192 and 4096 with compose.small-gpu.yaml)

# ---- Cloud reader (optional: a cloud vision model reads the photos instead of the llm service) ----
# WARNING: with READER_PROVIDER=remote the WHOLE receipt photo leaves this machine and goes to the provider you choose
# (OpenAI or OpenRouter). It shows the store and its address, the date and time, everything you bought, prices, the last
# digits of your card, member numbers, sometimes names, and barcodes. Location data (EXIF) in the photo is removed first.
# The hosted decider's anonymizing does NOT apply to photos. The provider may keep requests for a while and policies
# differ: check its current policy. With OpenRouter the request goes on to a third-party model provider; check your
# OpenRouter privacy settings (data collection / training).
# It costs money per photo and has not been tested on this pipeline's receipts: compare it with ./receipts replay first.
# To keep everything on this machine, leave READER_PROVIDER as local (the default; or delete these lines).
#
# local = the llm service reads on this machine. remote = the cloud reader below. ./receipts setup can switch for you
# (it adds compose.remote-reader.yaml to COMPOSE_FILE, so the llm service is not started).
# READER_URL is the API base (https only). /v1 is added only if the address has no path (https://api.openai.com); a path you
# give is kept as it is (.../v1, .../api/v1, .../v1beta/openai). Requests go to <READER_URL>/chat/completions.
# Pick a model that reads images and supports structured output. The pipeline sends only standard parameters
# (model, messages, temperature, max_tokens, response_format); LLM_THINKING, LLM_NAME and the llama.cpp sampling settings are
# ignored (only the temperature from LLM_SAMPLING is used). The key is only used in the request header and is never logged.
# With a cloud reader, category descriptions are not written automatically (they send category names, store names, amounts and
# item notes): ./receipts describe lists what is sent and asks first.
#READER_PROVIDER=local
# OpenAI:
#READER_URL=https://api.openai.com/v1
#READER_MODEL=gpt-4.1-mini
# OpenRouter instead (model ids look like vendor/model):
#READER_URL=https://openrouter.ai/api/v1
#READER_MODEL=openai/gpt-4.1-mini
#READER_API_KEY=

# ---- Hosted decider (optional: TypeSafe's Jev instead of the decider-gguf service) ----
# WARNING: with DECIDER_PROVIDER=remote, text about your purchases leaves this machine and goes to TypeSafe.
# local = the decider runs on this machine and nothing leaves it. remote = the decider runs on TypeSafe's hosted Jev
# (https://docs.typesafe.ai), which needs an API key, frees about 3-7 GB of GPU memory and costs about $0.042 per
# million input tokens. ./receipts setup can switch for you (it also adds compose.remote-decider.yaml to COMPOSE_FILE,
# so the local decider is not started). The receipt reader stays on this machine unless you also choose the cloud reader above.
# What leaves the machine, always anonymized first (no switch to turn that off): the item lines, the store name (as the payee
# name in Actual) and amounts, with category names replaced by codes (C01, C02...), dates made relative ("12 days before
# this purchase"), people's names replaced by Person A, Person B..., and places by "a city", "a state" or "a street".
# Your past purchases and notes at the same store go along the same way. Never sent: the receipt photo, card digits, payment
# method, addresses, the printed date, calendar event names. Names are found two ways: the lists below (and the Privacy
# page), and a scan by the reader (the local one, or the cloud reader if you chose it: see CLOUD_NAME_SCAN below).
# Anonymizing is automatic and can miss a name it does not know: preview what would be sent with
# ./receipts replay --preview-remote <folder> (sends nothing to the hosted decider; with a cloud reader the photos, and with
# CLOUD_NAME_SCAN the name-scan texts, still go to the reader's provider; see docs/how-it-works.md).
#DECIDER_PROVIDER=local
#DECIDER_API_KEY=
#DECIDER_URL=https://api.typesafe.ai
#DECIDER_REMOTE_MODEL=jev-latest
# Hosted decider AND cloud reader together: the name and place scan runs on the reader, so the raw receipt text (item lines,
# store names, amounts, your category notes) would go to the cloud reader's provider before anonymizing. The worker refuses to
# start with both hosted unless you accept that here. Ignored if either is local.
#CLOUD_NAME_SCAN=false
# First names, nicknames and pet names of your household, comma-separated. Replaced everywhere in what is sent. It seeds
# data/private-words.json once; after that edit the list on the status page (Privacy).
#PRIVATE_WORDS=Alex,Sam,Rex
# Your town, street or ZIP code, comma-separated. Replaced by "a place" in everything sent to the hosted decider. The reader
# model also looks for cities, states, streets and ZIP codes on its own. Seeds data/private-words.json once; after that edit
# the list on the status page (Privacy).
#PRIVATE_PLACES=Springfield,12345

# ---- Advanced: where files live inside the container (./data on this machine is /data there) ----
# You normally never set these. Defaults shown.
#SETTINGS_PATH=/data/settings.json
#CATEGORY_NOTES_PATH=/data/category-notes.json
#PRIVATE_WORDS_PATH=/data/private-words.json
#NAME_SCAN_CACHE_PATH=/data/name-scan-cache.json
#ALERT_PATH=/data/worker-alert.json
#RESEARCH_DIR=/data/research
#ACTUAL_DATA_DIR=/data/actual-cache
#ACTUAL_API_DIR=/data/actual-api
