# Dummy, non-secret values for `npm test` (node --env-file=test.env). Tests never talk to these hosts.
ACTUAL_SERVER_URL=http://actual.invalid
ACTUAL_PASSWORD=test
ACTUAL_SYNC_ID=test
NEXTCLOUD_URL=http://nextcloud.invalid
NEXTCLOUD_USER=test
NEXTCLOUD_APP_PASSWORD=test
# Keep tests away from /data.
KEYWORDS_PATH=/tmp/receipt-pipeline-test/keywords.json
CATEGORY_NOTES_PATH=/tmp/receipt-pipeline-test/category-notes.json
ACTUAL_DATA_DIR=/tmp/receipt-pipeline-test/actual-cache
SETTINGS_PATH=/tmp/receipt-pipeline-test/settings.json
MEMORY_DIR=/tmp/receipt-pipeline-test/memory
# The per-receipt decider question adds a request to every receipt; the tests that count requests leave it off, and its own tests turn it on.
RECEIPT_CHECK=off
